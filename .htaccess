
# CreatePosts - React SPA + PHP Backend
# Compatible with Namecheap shared hosting (Apache)

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Allow PHP backend and cPanel system paths
    RewriteRule ^(backend|\.well-known|cgi-bin)(/|$) - [L]

    # 2. Prevent rewriting files already inside the React build
    RewriteRule ^frontend/dist/ - [L]

    # 3. Serve React build assets (JS, CSS, images, fonts)
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f
    RewriteRule ^(assets/.+|[^/]+\.[A-Za-z0-9]+)$ frontend/dist/$1 [L]

    # 4. Serve the React entry point
    RewriteRule ^$ frontend/dist/index.html [L]

    # 5. React Router fallback
    # Fixes 404 errors on refresh for:
    # /dashboard
    # /settings
    # /tasks/12
    # /any/react/route
    RewriteRule ^ frontend/dist/index.html [L]
</IfModule>
