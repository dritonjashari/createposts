# Vite copies this file into dist/. Requests only arrive here already routed
# by the .htaccess in the repository root, so there's nothing to rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

<IfModule mod_headers.c>
  # Built assets have a content hash in their name (index-BqUYUc7k.js), so
  # they can be cached forever.
  <FilesMatch "-[0-9A-Za-z_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
